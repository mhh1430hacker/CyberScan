{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheSetup",
      "Effect": "Allow",
      "Action": [
        "lambda:Get*", "lambda:List*",
        "s3:ListAllMyBuckets", "s3:GetBucket*", "s3:ListBucket", "s3:GetObject", "s3:GetEncryptionConfiguration",
        "cloudfront:Get*", "cloudfront:List*",
        "iam:GetRole", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListOpenIDConnectProviders", "iam:GetOpenIDConnectProvider",
        "logs:Describe*", "logs:Get*", "logs:FilterLogEvents",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "FixTheSetup",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionConfiguration", "lambda:UpdateFunctionCode", "lambda:PublishVersion", "lambda:UpdateAlias",
        "s3:PutObject", "s3:DeleteObject", "s3:PutBucketCors", "s3:PutBucketPolicy",
        "cloudfront:UpdateDistribution", "cloudfront:CreateInvalidation",
        "cloudfront:CreateOriginAccessControl", "cloudfront:CreateCachePolicy",
        "iam:CreateOpenIDConnectProvider", "iam:CreateRole", "iam:PutRolePolicy", "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "*"
    }
  ]
}
