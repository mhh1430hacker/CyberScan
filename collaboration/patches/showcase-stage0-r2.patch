@@ -0,0 +1,202 @@
+"""The landing page's story data (web_v/static/data/story.json) and its browser validator.
+
+- The demo file is rebuilt here from web_v/make_story_data.py (no engine needed) and must match
+  the committed JSON: same bytes, same SHA-256, same entropy figures.
+- The JSON carries no timestamp, so regenerating it with unchanged engines changes nothing.
+- The validator in static/js/story.js, which the hero card and the story share, is run in Node
+  on the real file and on malformed variants: each malformed variant must be rejected (null),
+  exactly as a missing file is. Skipped when Node isn't installed.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+import importlib.util
+import json
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+WEB = ROOT / "web_v"
+STORY = WEB / "static" / "data" / "story.json"
+STORY_JS = WEB / "static" / "js" / "story.js"
+MARKER = "/* ---- end of story data validation ---- */"
+
+
+def _generator():
+    spec = importlib.util.spec_from_file_location("make_story_data", WEB / "make_story_data.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)  # top level only builds constants; engines load in main()
+    return module
+
+
+@pytest.fixture(scope="module")
+def story() -> dict:
+    return json.loads(STORY.read_text(encoding="utf-8"))
+
+
+def test_demo_file_matches_committed_data(story):
+    gen = _generator()
+    data = gen.build_demo()
+    assert data == gen.build_demo(), "the demo file must be deterministic"
+    assert story["file"]["size"] == len(data)
+    assert story["file"]["sha256"] == hashlib.sha256(data).hexdigest()
+    assert data.startswith(b"%PDF-") and data.count(b"%%EOF") == 2
+
+
+def test_entropy_is_a_64_byte_window_per_cell(story):
+    gen = _generator()
+    data = gen.build_demo()
+    cells = story["cells"]
+    assert cells["count"] == gen.CELLS == 320 and cells["entropy_window"] == gen.WINDOW == 64
+    assert "overlap" in cells["entropy_method"]
+    size = len(data)
+    for k, value in enumerate(cells["entropy"]):
+        mid = int((k + 0.5) * size / gen.CELLS)
+        lo = max(0, min(size - gen.WINDOW, mid - gen.WINDOW // 2))
+        assert value == round(gen.shannon(data[lo:lo + gen.WINDOW]), 2)
+
+
+def test_regions_are_the_real_byte_ranges(story):
+    data = _generator().build_demo()
+    tail = data.rindex(b"%%EOF\n") + len(b"%%EOF\n")
+    first_eof = data.index(b"%%EOF\n") + len(b"%%EOF\n")
+    spans = {r["tag"]: r for r in story["regions"] if "start" in r}
+    assert spans[2]["start"] == tail and spans[2]["end"] == len(data)   # data after the end
+    assert first_eof <= spans[1]["start"] < spans[1]["end"] == tail      # the added update
+    assert b"/JavaScript" in data[spans[1]["start"]:spans[1]["end"]]
+    assert story["repair"]["size_after"] + story["repair"]["removed_bytes"] == len(data)
+
+
+def test_no_timestamp_in_generated_data(story):
+    text = STORY.read_text(encoding="utf-8")
+    assert "generated" not in story
+    assert not re.search(r"(19|20)\d\d-\d\d-\d\d", text), "no ISO dates in the generated file"
+
+
+# ---- the shared browser validator ---------------------------------------------------------
+
+def _set(path: str, value):
+    def change(d):
+        *head, last = path.split(".")
+        node = d
+        for key in head:
+            node = node[int(key)] if isinstance(node, list) else node[key]
+        if value is _DELETE:
+            del node[int(last) if isinstance(node, list) else last]
+        elif isinstance(node, list):
+            node[int(last)] = value
+        else:
+            node[last] = value
+        return d
+    return change
+
+
+_DELETE = object()
+
+
+def _region(tag):
+    return lambda d: next(r for r in d["regions"] if r["tag"] == tag)
+
+
+def _overlap(d):
+    one, two = _region(1)(d), _region(2)(d)
+    one["to"] = two["from"] + 5
+    one["end"] = round(one["to"] * d["file"]["size"] / 320)
+    return d
+
+
+def _duplicate_tag(d):
+    _region(2)(d)["tag"] = 1
+    return d
+
+
+MALFORMED = {
+    "not an object": lambda d: [d],
+    "file missing": _set("file", _DELETE),
+    "bad file name": _set("file.name", "../invoice.exe"),
+    "empty file name": _set("file.name", ""),
+    "size zero": _set("file.size", 0),
+    "size not an integer": _set("file.size", "2220"),
+    "sha256 too short": _set("file.sha256", "abc123"),
+    "sha256 uppercase": lambda d: _set("file.sha256", d["file"]["sha256"].upper())(d),
+    "score above 100": _set("scan.score", 101),
+    "score negative": _set("scan.score", -1),
+    "score fractional": _set("scan.score", 99.5),
+    "unknown classification": _set("scan.classification", "PROBABLY_FINE"),
+    "evidence not a list": _set("scan.evidence", "Double extension"),
+    "entropy too short": lambda d: (d["cells"]["entropy"].pop(), d)[1],
+    "entropy above 8": _set("cells.entropy.10", 8.5),
+    "entropy negative": _set("cells.entropy.10", -0.1),
+    "entropy not a number": _set("cells.entropy.10", "4.2"),
+    "cell count wrong": _set("cells.count", 319),
+    "regions not a list": _set("regions", {}),
+    "tag index 3": lambda d: (_region(2)(d).update(tag=3), d)[1],
+    "duplicate tag": _duplicate_tag,
+    "overlapping regions": _overlap,
+    "region past the last cell": lambda d: (_region(2)(d).update(to=321), d)[1],
+    "empty region": lambda d: (_region(1)(d).update(to=_region(1)(d)["from"]), d)[1],
+    "cells disagree with bytes": lambda d: (_region(1)(d).update(**{"from": 10}), d)[1],
+    "byte range past the file": lambda d: (_region(2)(d).update(end=d["file"]["size"] + 1), d)[1],
+    "no byte regions": lambda d: (d.update(regions=[r for r in d["regions"] if "start" not in r]), d)[1],
+    "repair fields missing": _set("repair.selected", _DELETE),
+    "repair sizes disagree": lambda d: (d["repair"].update(removed_bytes=d["repair"]["removed_bytes"] + 1), d)[1],
+    "repair failed a check": _set("repair.checks_failed", ["structure"]),
+    "rescan missing": _set("repair.rescan", _DELETE),
+    "rescan score above 100": _set("repair.rescan.score", 140),
+    "rescan classification unknown": _set("repair.rescan.classification", ""),
+    "repaired name invalid": _set("repair.name_after", "a/b.pdf"),
+}
+
+
+@pytest.fixture(scope="module")
+def node() -> str:
+    exe = shutil.which("node")
+    if not exe:
+        pytest.skip("Node.js is not installed")
+    return exe
+
+
+def _validate_all(node: str, cases: dict) -> dict:
+    source = STORY_JS.read_text(encoding="utf-8")
+    assert MARKER in source, "the validator block must stay at the top of story.js"
+    validator = source[: source.index(MARKER)]
+    program = (
+        "const cases = JSON.parse(require('fs').readFileSync(0, 'utf8'));\n"
+        + validator
+        + "\nconst out = {};\nfor (const [k, v] of Object.entries(cases)) out[k] = globalThis.CSStory.validate(v) !== null;\n"
+        "process.stdout.write(JSON.stringify(out));\n"
+    )
+    result = subprocess.run([node, "-e", program], input=json.dumps(cases), capture_output=True,
+                            text=True, encoding="utf-8", timeout=60, check=True)
+    return json.loads(result.stdout)
+
+
+def test_validator_accepts_the_committed_data(node, story):
+    assert _validate_all(node, {"valid": story}) == {"valid": True}
+
+
+def test_validator_rejects_missing_data(node):
+    assert _validate_all(node, {"null": None, "empty": {}, "string": "story"}) == {"null": False, "empty": False, "string": False}
+
+
+def test_validator_rejects_every_malformed_variant(node, story):
+    cases = {name: change(copy.deepcopy(story)) for name, change in MALFORMED.items()}
+    results = _validate_all(node, cases)
+    accepted = sorted(name for name, ok in results.items() if ok)
+    assert accepted == [], f"malformed story data was accepted: {accepted}"
+
+
+def test_card_and_story_share_one_validator():
+    landing = (WEB / "static" / "js" / "landing.js").read_text(encoding="utf-8")
+    story_js = STORY_JS.read_text(encoding="utf-8")
+    assert "CSStory.load()" in landing and "CSStory.load()" in story_js
+    # neither script may fetch the data on its own, around the validator
+    assert "fetch(" not in landing.split("/* ---------------- hero card", 1)[1].split("function playCard", 1)[0]
+    assert 'fetch("data/story.json"' not in landing
+    assert story_js.count('fetch("data/story.json"') == 1
+    assert story_js.index('fetch("data/story.json"') < story_js.index(MARKER)
