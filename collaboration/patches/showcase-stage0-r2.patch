@@ -0,0 +1,251 @@
+"""Precompute the numbers behind the landing page's scroll story and hero card.
+
+The story ("Inside one scan") follows one file, invoice_2026.pdf.exe. Every number it shows
+comes from this script running CyberScan's own code on that file:
+
+  - the scan goes through detection.service.default_service().analyze_upload, the same
+    bounded call /api/scan/file uses, so the score and verdict are what the workspace shows;
+  - the cut-out regions are the repair engine's own findings (repair_engine.analyze), and the
+    "rebuilt" figures are its repair of a copy, scanned again the same way.
+
+The demo file is built here, deterministically, and is harmless: a one-page PDF whose later
+incremental update adds an auto-run JavaScript action. That script only holds a text string;
+the "encoded PowerShell" in it decodes to  Write-Output 'CyberScan demo'. Behind the end of the
+PDF sit pseudo-random bytes (BLAKE2b in counter mode). Nothing is executed at any point.
+
+It is one example file, not a benchmark: the page says so next to the numbers.
+
+Entropy: each of the 320 cells stands for about size/320 bytes (about 7 here), but its value is
+the Shannon entropy (bits per byte, 0-8) of a 64-byte window centred on that cell, clamped to
+the file's ends. Windows are much wider than cells, so adjacent measurements overlap and the
+curve is smoothed; a 7-byte slice on its own can't exceed log2(7) bits and says little.
+
+Reproducibility: the output carries no timestamp. The demo file is built from constants, so its
+bytes and SHA-256 never change; for the same engine code the JSON is byte-identical on any day.
+A change in the JSON therefore means an engine's behaviour changed. The engine version is
+recorded in scan.engine.
+
+    python web_v/make_story_data.py [--engine-root PATH]
+
+--engine-root reads the engines from another checkout (default: this one); the output is
+always written next to this script. Needs the website's core/, detection/ and repair_engine/. Re-run after changing an engine.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import math
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = Path(__file__).resolve().parent / "static" / "data" / "story.json"
+NAME = "invoice_2026.pdf.exe"
+CELLS = 320          # story.js lays the file out as 16 x 20 cells
+WINDOW = 64          # bytes per entropy measurement, centred on each cell
+
+
+# ---- the demo file ---------------------------------------------------------------------------
+
+def _pdf_objects(start: int, bodies: list[tuple[int, bytes]], out: bytearray) -> dict[int, int]:
+    offsets = {}
+    for number, body in bodies:
+        offsets[number] = start + len(out)
+        out.extend(b"%d 0 obj\n" % number + body + b"\nendobj\n")
+    return offsets
+
+
+def _xref(offsets: dict[int, int]) -> bytes:
+    rows = [b"xref\n"]
+    for number in sorted(offsets):
+        rows.append(b"%d 1\n%010d 00000 n \n" % (number, offsets[number]))
+    return b"".join(rows)
+
+
+def _stream(payload: bytes) -> bytes:
+    return b"<< /Length %d >>\nstream\n" % len(payload) + payload + b"\nendstream"
+
+
+def build_demo() -> bytes:
+    lines = [
+        "Invoice 2026-0412", "CyberScan demo file - not a real invoice", "",
+        "Bill to: Example Trading Ltd, 1 Sample Street, Demo City", "Invoice date: 2026-04-12    Due: 2026-05-12", "",
+        "Item                                   Qty      Price",
+        "Consulting hours                        12     960.00",
+        "Security review                          1     480.00",
+        "Licence renewal                          1     240.00",
+        "Support plan (monthly)                   3     150.00",
+        "Training session                         2     320.00",
+        "Travel                                   1      85.00", "",
+        "Subtotal                                      2235.00",
+        "VAT 15%                                        335.25",
+        "Total due                                     2570.25", "",
+        "Pay by bank transfer to the account on your contract.",
+        "Questions? Reply to the address you received this from.",
+    ]
+    text = b"BT /F1 12 Tf 72 760 Td 16 TL " + b" ".join(b"(%s) '" % l.encode() for l in lines) + b" ET"
+
+    # version 1: an ordinary one-page document
+    out = bytearray(b"%PDF-1.7\n%\xe2\xe3\xcf\xd3\n")
+    offsets = {0: 0}
+    offsets.update(_pdf_objects(0, [
+        (1, b"<< /Type /Catalog /Pages 2 0 R >>"),
+        (2, b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>"),
+        (3, b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 5 0 R >> >> /Contents 4 0 R >>"),
+        (4, _stream(text)),
+        (5, b"<< /Type /Font /Subtype /Type1 /BaseFont /Courier >>"),
+    ], out))
+    offsets.pop(0)
+    first_xref = len(out)
+    out.extend(b"xref\n0 6\n0000000000 65535 f \n" + b"".join(b"%010d 00000 n \n" % offsets[n] for n in range(1, 6)))
+    out.extend(b"trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % first_xref)
+
+    # version 2: an incremental update that only adds an auto-run script
+    command = base64.b64encode("Write-Output 'CyberScan demo'".encode("utf-16-le")).decode()
+    script = f"var note = 'powershell -NoProfile -EncodedCommand {command}';".encode()
+    body = bytearray()
+    update = _pdf_objects(len(out), [
+        (1, b"<< /Type /Catalog /Pages 2 0 R /OpenAction 6 0 R >>"),
+        # inline script: the repair engine rolls back an update only when every object in it
+        # is the flagged action or the catalog (a separate /JS stream object is refused)
+        (6, b"<< /S /JavaScript /JS (" + script + b") >>"),
+    ], body)
+    out.extend(body)
+    second_xref = len(out)
+    out.extend(_xref(update))
+    out.extend(b"trailer\n<< /Size 7 /Root 1 0 R /Prev %d >>\nstartxref\n%d\n%%%%EOF\n" % (first_xref, second_xref))
+
+    # data after the end: deterministic pseudo-random bytes
+    tail = bytearray()
+    counter = 0
+    while len(tail) < 384:
+        tail += hashlib.blake2b(b"story" + counter.to_bytes(8, "little"), digest_size=64).digest()
+        counter += 1
+    out.extend(tail[:384])
+    return bytes(out)
+
+
+# ---- measurements ----------------------------------------------------------------------------
+
+def shannon(data: bytes) -> float:
+    if not data:
+        return 0.0
+    counts = [0] * 256
+    for b in data:
+        counts[b] += 1
+    n = len(data)
+    return -math.fsum(c / n * math.log2(c / n) for c in counts if c)
+
+
+def cell_of(offset: int, size: int) -> int:
+    return min(CELLS, round(offset * CELLS / size))
+
+
+def scan(service, data: bytes, name: str, settings: dict) -> dict:
+    envelope = service.analyze_upload(data, name, settings)
+    if envelope.get("status") != "ok":
+        raise SystemExit(f"scan of {name} did not complete: {envelope.get('error')}")
+    result = envelope["result"]
+    summary = result.get("detection_summary") or {}
+    return {
+        "score": int(result["combined_score"]),
+        "classification": summary.get("classification") or result.get("classification"),
+        "evidence": [
+            {"label": e.get("evidence"), "category": e.get("category"), "severity": e.get("severity"),
+             "contribution": int(e.get("contribution") or 0)}
+            for e in result.get("evidence") or [] if int(e.get("contribution") or 0) > 0
+        ],
+        "content_findings": [
+            {"label": f.get("label"), "severity": f.get("severity"), "contribution": int(f.get("contribution") or 0)}
+            for f in (result.get("content_analysis") or {}).get("findings") or []
+        ],
+        "mitre": [t.get("id") for t in result.get("mitre_techniques") or []],
+        "engine": envelope.get("engine"),
+    }
+
+
+def main() -> None:
+    root = ROOT
+    if "--engine-root" in sys.argv:
+        root = Path(sys.argv[sys.argv.index("--engine-root") + 1]).resolve()
+    sys.path.insert(0, str(root))
+    import config
+    from detection.service import default_service
+    from repair_engine.analyze import analyze, repair
+
+    data = build_demo()
+    size = len(data)
+    settings = dict(config.DEFAULT_SETTINGS)
+    service = default_service()
+    before = scan(service, data, NAME, settings)
+
+    report = analyze(data, NAME)
+    findings = {f.key: f for f in report.findings}
+    update = findings.get("pdf_update")
+    tail = next((f for f in report.findings if f.kind == "after_eof"), None)
+    double = findings.get("name_double")
+    mismatch = findings.get("name_mismatch")
+    if not (update and tail and double and mismatch):
+        raise SystemExit(f"repair engine findings changed: {sorted(findings)}; update the story")
+    assert update.repairable and tail.repairable, "the story shows these parts being cut out"
+
+    # The repair the story shows, chosen the way a user would in the workspace's Repair view:
+    # roll back the update, cut the tail, and take the rename that matches the real content.
+    fixed = repair(data, NAME, [mismatch, update, tail])
+    if not (fixed.ok and fixed.repaired is not None):
+        raise SystemExit(f"repair did not complete: {fixed.message}")
+    after = scan(service, fixed.repaired, fixed.name, settings)
+    checks = dict(fixed.validation.checks) if fixed.validation else {}
+    failures = dict(fixed.validation.failures) if fixed.validation else {}
+
+    entropy = []
+    for k in range(CELLS):
+        mid = int((k + 0.5) * size / CELLS)
+        lo = max(0, min(size - WINDOW, mid - WINDOW // 2))
+        entropy.append(round(shannon(data[lo:lo + WINDOW]), 2))
+
+    payload = {
+        "generator": "web_v/make_story_data.py",
+        "reproducible": "No timestamp: same engine code, same bytes. See the module docstring.",
+        "note": "One deterministic, harmless demo file scanned by CyberScan's own code. One example, not a benchmark.",
+        "file": {
+            "name": NAME, "size": size, "sha256": hashlib.sha256(data).hexdigest(),
+            "format": report.format,
+        },
+        "scan": before,
+        "cells": {
+            "count": CELLS, "bytes_per_cell": round(size / CELLS, 2), "entropy_window": WINDOW,
+            "entropy_method": f"Shannon entropy in bits per byte of a {WINDOW}-byte window centred on each cell "
+                              "(clamped to the file's ends); adjacent windows overlap.",
+            "entropy": entropy,
+        },
+        "regions": [
+            # the name is not stored in the bytes: story.js flags the file's label for it
+            {"tag": 0, "finding": double.key, "on": "name"},
+            {"tag": 1, "finding": update.key, "start": update.start, "end": tail.start,
+             "from": cell_of(update.start, size), "to": cell_of(tail.start, size)},
+            {"tag": 2, "finding": tail.key, "start": tail.start, "end": size,
+             "from": cell_of(tail.start, size), "to": CELLS},
+        ],
+        "repair": {
+            "selected": [mismatch.key, update.key, tail.key],
+            "name_after": fixed.name,
+            "removed_bytes": int(fixed.removed_bytes or 0),
+            "size_after": len(fixed.repaired),
+            "sha256_after": hashlib.sha256(fixed.repaired).hexdigest(),
+            "checks_passed": sorted(k for k, v in checks.items() if v),
+            "checks_failed": sorted(failures),
+            "rescan": {"score": after["score"], "classification": after["classification"],
+                       "evidence": after["evidence"]},
+        },
+    }
+    OUT.parent.mkdir(parents=True, exist_ok=True)
+    OUT.write_text(json.dumps(payload, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(f"wrote {OUT} ({OUT.stat().st_size:,} bytes)")
+    print(f"before: {before['score']} {before['classification']}  after: {after['score']} {after['classification']}")
+    print(f"removed {fixed.removed_bytes} of {size} bytes; checks failed: {sorted(failures) or 'none'}")
+
+
+if __name__ == "__main__":  # the scan service may start worker processes
+    main()
