diff --git a/web_v/static/js/story.js b/web_v/static/js/story.js
index a4c8e13..a8d7f70 100644
--- a/web_v/static/js/story.js
+++ b/web_v/static/js/story.js
@@ -7,7 +7,84 @@
  *   2 a beam sweeps them; three regions light up red with labels
  *   3 the red cells are sealed into an encrypted vault
  *   4 what is left reassembles as a smaller, healthy page
+ *
+ * The numbers are engine output: data/story.json is written by web_v/make_story_data.py,
+ * which builds the (harmless) demo file and runs CyberScan's scan and repair engines on it.
+ * Each cell stands for 1/320 of that file (about 7 bytes) and is coloured by the Shannon
+ * entropy of a 64-byte window centred on it, so neighbouring cells' windows overlap. The red
+ * regions are the repair engine's findings at their real offsets; the HUD shows the real
+ * scores before and after the repair.
+ *
+ * If the file is missing, can't be fetched or fails validation, the story plays its original
+ * choreography in amber, labelled ILLUSTRATIVE, with no score ("—"). The label is removed only
+ * after the data has validated.
  */
+
+/* Story data: one fetch and one validator, shared with landing.js (loaded after this file),
+ * so the hero card and the story always agree on whether the data is valid. Returns the data
+ * or null; malformed data is treated exactly like missing data. */
+(function (root) {
+  "use strict";
+  const CELLS = 320, MAX_SIZE = 4 * 1024 * 1024;
+  const CLASSES = ["SUSPICIOUS", "REVIEW", "UNKNOWN", "NO_INDICATORS_OBSERVED", "SAFE", "CLEAN"];
+  const NAME = /^[A-Za-z0-9][A-Za-z0-9._ -]{0,119}$/;
+  const SHA256 = /^[0-9a-f]{64}$/;
+  const isInt = (v, lo, hi) => Number.isInteger(v) && v >= lo && v <= hi;
+  const isObj = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
+  const isName = (v) => typeof v === "string" && NAME.test(v);
+  const isSha = (v) => typeof v === "string" && SHA256.test(v);
+  const isVerdict = (s) => isObj(s) && isInt(s.score, 0, 100) && CLASSES.includes(s.classification);
+
+  function validate(d) {
+    try {
+      if (!isObj(d) || !isObj(d.file) || !isObj(d.scan) || !isObj(d.cells) || !isObj(d.repair) || !Array.isArray(d.regions)) return null;
+      const f = d.file;
+      if (!isName(f.name) || !isInt(f.size, 1, MAX_SIZE) || !isSha(f.sha256)) return null;
+      if (!isVerdict(d.scan) || !Array.isArray(d.scan.evidence) || !d.scan.evidence.every((e) => isObj(e) && typeof e.label === "string")) return null;
+      const c = d.cells;
+      if (c.count !== CELLS || !Array.isArray(c.entropy) || c.entropy.length !== CELLS) return null;
+      if (!c.entropy.every((e) => typeof e === "number" && Number.isFinite(e) && e >= 0 && e <= 8)) return null;
+      const tags = new Set(), spans = [];
+      for (const r of d.regions) {
+        if (!isObj(r) || !isInt(r.tag, 0, 2) || tags.has(r.tag)) return null;
+        tags.add(r.tag);
+        if (r.on === "name") continue;
+        if (r.on !== undefined || !isInt(r.from, 0, CELLS - 1) || !isInt(r.to, r.from + 1, CELLS)) return null;
+        if (!isInt(r.start, 0, f.size - 1) || !isInt(r.end, r.start + 1, f.size)) return null;
+        // the cell range must be the byte range, scaled to 320 cells
+        if (Math.abs(r.from - Math.round((r.start * CELLS) / f.size)) > 1 || Math.abs(r.to - Math.round((r.end * CELLS) / f.size)) > 1) return null;
+        spans.push(r);
+      }
+      if (!spans.length) return null;
+      spans.sort((a, b) => a.from - b.from);
+      for (let i = 1; i < spans.length; i++) if (spans[i].from < spans[i - 1].to) return null;
