+
+/* ---------- showcase stage 0: provenance labels, story HUD clearance, mobile hero ---------- */
+/* "engine output" appears only once data/story.json has loaded (landing.js / story.js add the class) */
+.prov-tag { display: inline-block; font: 600 10.5px/1 Consolas, ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; padding: 4px 7px; border-radius: 4px; vertical-align: 1px; color: #052e1a; background: #34d399; }
+[dir="rtl"] .prov-tag { font-family: inherit; letter-spacing: 0; }
+.sc-prov, .story-prov { display: none; }
+.scan-card.has-engine-data .sc-prov { display: block; margin: 14px 0 0; font-size: 12px; line-height: 1.55; color: var(--muted); }
+.story.has-engine-data .story-prov { display: block; margin: 14px 0 0; font-size: 12.5px; line-height: 1.55; color: var(--muted); }
+.story-prov-meta { display: block; margin-top: 4px; font: 11.5px/1.4 Consolas, ui-monospace, monospace; color: #8aa0bc; overflow-wrap: anywhere; }
+.scan-card .sc-list li[hidden], .scan-card .sc-verdict[hidden] { display: none; }
+
+/* I2: the story's HUD sat under the floating "Ask the AI" button */
+.story .story-hud { bottom: 92px; }
+@media (max-width: 900px) {
+  .story .story-hud { bottom: 16px; inset-inline: 16px 210px; }
+}
+@media (max-width: 600px) {
+  .story .story-hud { inset-inline: 12px 76px; gap: 6px; }
+  .story .story-hud > span { padding: 7px 10px; }
+}
+
+/* I3: on narrow screens the headline and intro sat directly on the particle shield */
+@media (max-width: 1000px) {
+  .hero-copy { position: relative; z-index: 1; }
+  .hero-copy::before {
+    content: ""; position: absolute; inset: -28px -16px; z-index: -1; pointer-events: none;
+    background: radial-gradient(120% 75% at 35% 50%, rgba(7, 4, 15, .82), rgba(7, 4, 15, .55) 55%, rgba(7, 4, 15, 0) 85%);
+  }
+  .hero-sub { color: #c3cfdf; text-shadow: 0 1px 12px rgba(7, 4, 15, .9); }
+}
