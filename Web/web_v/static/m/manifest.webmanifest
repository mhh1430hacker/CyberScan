{
  "id": "/m/",
  "name": "CyberScan",
  "short_name": "CyberScan",
  "description": "Check files, links and text on your phone. The analysis runs on the device; nothing is uploaded.",
  "start_url": "/m/",
  "scope": "/m/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#07051a",
  "theme_color": "#07051a",
  "categories": ["security", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/m/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Check a file", "url": "/m/" }
  ]
}
